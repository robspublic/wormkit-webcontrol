# Copy to .env and adjust. All vars are prefixed WKWC_.

# Force the in-process mock transport (no running game needed).
# Set 1 for local dev without the game; set 0 to talk to the real DLL over TCP.
WKWC_USE_MOCK_IPC=1

# Host/port of the DLL's TCP IPC server (must match the ini's Port). The DLL
# listens on 127.0.0.1 inside Wine/Proton, reachable on the same host.
WKWC_GAME_HOST=127.0.0.1
WKWC_GAME_PORT=27099

# SQLite file for the team<->email mapping.
WKWC_DB_PATH=wkwebcontrol.db

# Header the trusted oauth-proxy/nginx sets with the authenticated email.
WKWC_AUTH_EMAIL_HEADER=X-Auth-Email

# Comma-separated admin emails. Empty = any authenticated user is admin (dev).
WKWC_ADMIN_EMAILS=
