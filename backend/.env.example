# Copy to .env and adjust. All vars are prefixed WKWC_.

# Force the in-process mock transport (no game / no Windows needed).
# Leave as 1 for local dev on Linux; set 0 in production on the Windows host.
WKWC_USE_MOCK_IPC=1

# Named pipe the DLL listens on (production, Windows).
WKWC_PIPE_NAME=\\.\pipe\wkwebcontrol

# SQLite file for the team<->email mapping.
WKWC_DB_PATH=wkwebcontrol.db

# Header the trusted oauth-proxy/nginx sets with the authenticated email.
WKWC_AUTH_EMAIL_HEADER=X-Auth-Email

# Comma-separated admin emails. Empty = any authenticated user is admin (dev).
WKWC_ADMIN_EMAILS=
