[wkWebControl]
; Master enable switch for the module.
Enabled=1

; Allocate a console window and print diagnostic logs there.
DevConsole=0

; Verify the running WA.exe matches the version this module targets (3.8.1).
CheckWaVersion=1

; Single-instance guard.
Mutex=1

; TCP port the module's IPC server listens on (127.0.0.1). The FastAPI backend
; connects here. Must match the backend's WKWC_GAME_PORT.
Port=27099
